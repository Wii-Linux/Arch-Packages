pkgbase=npll
pkgname=(npll npll-mini)
pkgver=0.6
pkgrel=1
pkgdesc="Universal Nintendo PowerPC Linux Bootloader"
arch=('powerpc')
url="https://wii-linux.org"
license=(GPL-2.0-only)

source=("git+https://github.com/Wii-Linux/NPLL#tag=v${pkgver}"
        "https://github.com/devkitPro/gamecube-tools/raw/3b7f914df771d4b779d88607ceed2ec9264ff93a/elftool/elf2dol.c")
sha256sums=('3a1bb6ea83af43df9c3c6047bd5ac69d7b0c2cae8201d0cace4ffb63e2eb692c'
            '9c6433c983db1d72c933e81ce8aad5a3ee79efc1bc08fbc817021eaf4294217c')
makedepends=(
	'gcc'
	'binutils'
	'glibc'
	'git'
	'armeb-none-eabi-gcc'
	# FIXME: drop specific version once fully merged into ArchPOWER
	'armeb-none-eabi-binutils=2.44-1.3'
)

prepare() {
	cd "${srcdir}/NPLL"
	git submodule update --init --recursive
}

build() {
	$CC $CFLAGS "${srcdir}/elf2dol.c" -o "${srcdir}/elf2dol"
	cd "${srcdir}/NPLL"

	# so it can find elf2dol
	export PATH="$PATH:$srcdir"
	make
}

package_npll() {
	depends=(npll-mini wii-linux-utils)
	provides=(wii-linux-bootloader)
	install=npll.install

	mkdir -p "${pkgdir}/usr/lib/npll"
	cp "${srcdir}/NPLL/bin/"* "${pkgdir}/usr/lib/npll/"
}

package_npll-mini() {
	# as a hack to refer to the actual gumboot package; pkgrel will always be >=50 on npll-gumboot-legacy
	conflicts=(gumboot-mini 'gumboot<=0.7-49')
	mkdir -p "${pkgdir}/usr/lib/npll"
	# TODO: we may eventually want to split off the build so we can get a MINI with debug output
	cp "${srcdir}/NPLL/external/mini/armboot.bin" "${pkgdir}/usr/lib/npll/armboot.bin"
}

apb_extra_repos=(
  "extra-any::https://repo.wii-linux.org/arch/extra/any"
  "extra::https://repo.wii-linux.org/arch/extra/$arch"
)

